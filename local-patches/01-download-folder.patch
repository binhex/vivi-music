@@ -0,0 +1,404 @@
+/**
+ * vivimusic Project (C) 2026
+ * Licensed under GPL-3.0 | See git history for contributors
+ */
+
+package com.music.vivi.playback
+
+import android.content.ContentResolver
+import android.content.ContentUris
+import android.content.ContentValues
+import android.content.Context
+import android.net.Uri
+import android.os.Build
+import android.os.Environment
+import android.provider.MediaStore
+import androidx.annotation.RequiresApi
+import androidx.core.net.toUri
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.datasource.DataSpec
+import androidx.media3.datasource.cache.CacheDataSource
+import androidx.media3.datasource.cache.SimpleCache
+import com.music.vivi.db.MusicDatabase
+import com.music.vivi.db.entities.Song
+import com.music.vivi.di.DownloadCache
+import com.music.vivi.utils.dataStore
+import com.music.vivi.utils.get
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import timber.log.Timber
+import java.io.File
+import java.io.IOException
+import java.io.OutputStream
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Copies a finished download out of the private Media3 cache (`filesDir/download`, which the user can
+ * never see) into a real audio file, so downloaded tracks show up in a file manager or any other
+ * music player.
+ *
+ * Destination:
+ *  - the SAF folder picked in Storage settings, when one is set and the write succeeds, otherwise
+ *  - `Music/Vivi` in public storage via MediaStore on API 29+, or the app-specific external music
+ *    directory on API 26-28 (visible to file managers there, and it needs no runtime permission).
+ *
+ * Below whichever root is used, the file goes into the subfolders resolved from the folder structure
+ * template (default `%artist%/%album%`).
+ *
+ * The cached download is never modified - it stays the source for offline playback - so an export
+ * failure can never break playback or lose the download.
+ */
+@OptIn(UnstableApi::class)
+@Singleton
+class DownloadFolderExporter
+@Inject
+constructor(
+    @ApplicationContext private val context: Context,
+    private val database: MusicDatabase,
+    @DownloadCache private val downloadCache: SimpleCache,
+) {
+    /** Exports are small local copies; serialising them keeps a re-download from racing itself. */
+    private val exportMutex = Mutex()
+
+    /**
+     * Exports [songId] when the feature is enabled. Never throws: failures are logged and the cached
+     * download stays intact.
+     */
+    suspend fun export(songId: String) {
+        withContext(Dispatchers.IO) {
+            if (context.dataStore[DownloadFolderExportEnabledKey] == false) return@withContext
+            exportMutex.withLock { exportLocked(songId) }
+        }
+    }
+
+    private suspend fun exportLocked(songId: String) {
+        val song = try {
+            database.song(songId).first()
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Timber.tag(TAG).w(e, "Could not read song %s", songId)
+            null
+        }
+        if (song == null) {
+            Timber.tag(TAG).w("No database row for %s, skipping export", songId)
+            return
+        }
+
+        val input = song.toTemplateInput()
+
+        try {
+            // Inside the try: export() is fired and forgotten from DownloadUtil's own scope, so a
+            // preference read failure must not escape as an uncaught exception.
+            val template = FolderTemplate.templateOrDefault(context.dataStore[DownloadFolderTemplateKey])
+            if (FolderTemplate.parse(template).tooDeep) {
+                Timber.tag(TAG).w(
+                    "Template uses more than %d folders, the extra ones are ignored",
+                    FolderTemplate.MAX_SEGMENTS,
+                )
+            }
+            val mimeType = sniffMimeType(songId)
+                ?: song.format?.mimeType.orEmpty().substringBefore(';').trim()
+                    .ifEmpty { FolderTemplate.DEFAULT_MIME_TYPE }
+            val fileName = FolderTemplate.fileName(input, mimeType)
+            val segments = FolderTemplate.expand(input, template)
+            write(songId, fileName, mimeType, segments)
+            Timber.tag(TAG).i("Exported %s as %s", songId, fileName)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Timber.tag(TAG).e(e, "Export failed for %s, cached download is intact", songId)
+        }
+    }
+
+    private fun write(songId: String, fileName: String, mimeType: String, segments: List<String>) {
+        val folderUri = context.dataStore[DownloadFolderUriKey].orEmpty()
+        if (folderUri.isNotBlank()) {
+            try {
+                writeToDocumentTree(folderUri.toUri(), songId, fileName, mimeType, segments)
+                return
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                // A revoked grant or a folder that turned read-only must not lose the export: fall
+                // through to Music/Vivi instead of writing nothing at all.
+                Timber.tag(TAG).w(e, "Chosen folder failed, using Music/%s", SUBFOLDER)
+            }
+        }
+        writeToPublicMusic(songId, fileName, mimeType, segments)
+    }
+
+    /**
+     * Writes beside the target name and only swaps it in once the copy succeeded, so an interrupted
+     * export cannot truncate the previous file.
+     */
+    private fun writeToDocumentTree(
+        treeUri: Uri,
+        songId: String,
+        fileName: String,
+        mimeType: String,
+        segments: List<String>,
+    ) {
+        val directory = SafFolders.resolveDirectory(context, treeUri, segments)
+        val existing = SafFolders.findFile(context, treeUri, directory, fileName)
+        val target = if (existing == null) fileName else "$fileName$PART_SUFFIX"
+        val uri = SafFolders.createFile(context, directory, mimeType, target)
+            ?: throw IOException("Could not create $target in $directory")
+        try {
+            val output = context.contentResolver.openOutputStream(uri, OPEN_MODE_TRUNCATE)
+                ?: throw IOException("Could not open output stream for $uri")
+            output.use { copyFromCache(songId, it) }
+        } catch (e: Exception) {
+            SafFolders.delete(context, uri)
+            throw e
+        }
+        if (existing != null) {
+            SafFolders.delete(context, existing)
+            if (SafFolders.rename(context, uri, fileName) == null) {
+                Timber.tag(TAG).w("Could not rename %s to %s", target, fileName)
+            }
+        }
+    }
+
+    private fun writeToPublicMusic(
+        songId: String,
+        fileName: String,
+        mimeType: String,
+        segments: List<String>,
+    ) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) {
+            writeToAppSpecificMusicDir(songId, fileName, segments)
+        } else {
+            writeViaMediaStore(songId, fileName, mimeType, segments)
+        }
+    }
+
+    @RequiresApi(Build.VERSION_CODES.Q)
+    private fun writeViaMediaStore(
+        songId: String,
+        fileName: String,
+        mimeType: String,
+        segments: List<String>,
+    ) {
+        val resolver = context.contentResolver
+        val collection = MediaStore.Audio.Media.EXTERNAL_CONTENT_URI
+        val relativePath = buildString {
+            append(Environment.DIRECTORY_MUSIC).append('/').append(SUBFOLDER)
+            segments.forEach { append('/').append(it) }
+        }
+
+        deleteOwnExports(resolver, collection, fileName, relativePath)
+
+        val uri = resolver.insert(
+            collection,
+            ContentValues().apply {
+                put(MediaStore.Audio.Media.DISPLAY_NAME, fileName)
+                put(MediaStore.Audio.Media.MIME_TYPE, mimeType)
+                put(MediaStore.Audio.Media.RELATIVE_PATH, relativePath)
+                put(MediaStore.Audio.Media.IS_PENDING, 1)
+            },
+        ) ?: throw IOException("MediaStore refused to create $fileName")
+
+        try {
+            val output = resolver.openOutputStream(uri)
+                ?: throw IOException("Could not open output stream for $uri")
+            output.use { copyFromCache(songId, it) }
+        } catch (e: Exception) {
+            runCatching { resolver.delete(uri, null, null) }
+            throw e
+        }
+
+        // Publishing is best effort: failing to clear IS_PENDING must not delete a complete file.
+        runCatching {
+            resolver.update(
+                uri,
+                ContentValues().apply { put(MediaStore.Audio.Media.IS_PENDING, 0) },
+                null,
+                null,
+            )
+        }.onFailure { Timber.tag(TAG).w(it, "Could not publish %s", fileName) }
+    }
+
+    /**
+     * Removes this app's previous export of the same song so the new file can take the name.
+     *
+     * Only rows this package owns are deleted - a same-named file from another app is not ours, and
+     * MediaStore renames ours instead of overwriting it - and a refused delete is logged rather than
+     * failing the export.
+     */
+    @RequiresApi(Build.VERSION_CODES.Q)
+    private fun deleteOwnExports(
+        resolver: ContentResolver,
+        collection: Uri,
+        fileName: String,
+        relativePath: String,
+    ) {
+        val ownedIds = mutableListOf<Long>()
+        runCatching {
+            resolver.query(
+                collection,
+                arrayOf(MediaStore.Audio.Media._ID, MediaStore.MediaColumns.OWNER_PACKAGE_NAME),
+                "${MediaStore.Audio.Media.DISPLAY_NAME} = ? AND " +
+                    "${MediaStore.Audio.Media.RELATIVE_PATH} = ?",
+                arrayOf(fileName, "$relativePath/"),
+                null,
+            )?.use { cursor ->
+                while (cursor.moveToNext()) {
+                    if (cursor.getString(1) == context.packageName) ownedIds += cursor.getLong(0)
+                }
+            }
+        }.onFailure { Timber.tag(TAG).w(it, "Could not look up a previous export of %s", fileName) }
+
+        ownedIds.forEach { id ->
+            runCatching { resolver.delete(ContentUris.withAppendedId(collection, id), null, null) }
+                .onFailure { Timber.tag(TAG).w(it, "Could not replace the previous export of %s", fileName) }
+        }
+    }
+
+    /**
+     * API 26-28: no MediaStore write without a runtime storage permission, but `Android/data` is not
+     * hidden yet on these versions, so the app-specific external directory is still user-visible.
+     */
+    private fun writeToAppSpecificMusicDir(songId: String, fileName: String, segments: List<String>) {
+        val base = context.getExternalFilesDir(Environment.DIRECTORY_MUSIC)
+        if (base == null) {
+            Timber.tag(TAG).w("External music directory unavailable, using internal storage")
+        }
+        val directory = File(base ?: context.filesDir, (listOf(SUBFOLDER) + segments).joinToString("/"))
+        if (!directory.exists() && !directory.mkdirs()) {
+            Timber.tag(TAG).w("Could not create %s", directory)
+        }
+        // Stage the copy for the same reason as the SAF path: an interrupted export must not
+        // truncate the previous file.
+        val staging = File(directory, "$fileName$PART_SUFFIX")
+        try {
+            staging.outputStream().use { copyFromCache(songId, it) }
+            val target = File(directory, fileName)
+            if (target.exists() && !target.delete()) {
+                Timber.tag(TAG).w("Could not replace %s", target)
+            }
+            if (!staging.renameTo(target)) {
+                Timber.tag(TAG).w("Could not rename %s to %s", staging, target)
+            }
+        } catch (e: Exception) {
+            runCatching { staging.delete() }
+            throw e
+        }
+    }
+
+    /**
+     * Reads the finished download straight out of the download cache.
+     *
+     * The request is bounded to the bytes the cache actually holds: a null upstream means "the cache
+     * contains everything requested", so reading past that point would be an error rather than the
+     * end of the stream.
+     */
+    private fun copyFromCache(songId: String, output: OutputStream) {
+        val expected = downloadCache.getCachedBytes(songId, 0, Long.MAX_VALUE)
+        if (expected <= 0L) throw IOException("Nothing cached for $songId")
+
+        val dataSource = CacheDataSource(downloadCache, null)
+        try {
+            dataSource.open(
+                DataSpec.Builder()
+                    .setUri(songId.toUri())
+                    .setKey(songId)
+                    .setLength(expected)
+                    .build(),
+            )
+            var total = 0L
+            val buffer = ByteArray(BUFFER_SIZE)
+            while (total < expected) {
+                val request = minOf(buffer.size.toLong(), expected - total).toInt()
+                val read = dataSource.read(buffer, 0, request)
+                if (read <= 0) break
+                output.write(buffer, 0, read)
+                total += read
+            }
+            if (total != expected) throw IOException("Copied $total of $expected cached bytes for $songId")
+        } finally {
+            runCatching { dataSource.close() }
+        }
+    }
+
+    /**
+     * Names the file after the container that was actually downloaded.
+     *
+     * The stored format row is rewritten by every stream resolution and the audio quality setting
+     * selects different containers, so it can disagree with the cached bytes; the extension decides
+     * whether a player will even try to open the file. Null falls back to the stored mime type.
+     */
+    private fun sniffMimeType(songId: String): String? {
+        val available = downloadCache.getCachedBytes(songId, 0, Long.MAX_VALUE)
+        if (available <= 0L) return null
+        val sniffLength = minOf(available, MAGIC_SIZE.toLong()).toInt()
+
+        val dataSource = CacheDataSource(downloadCache, null)
+        return try {
+            dataSource.open(
+                DataSpec.Builder()
+                    .setUri(songId.toUri())
+                    .setKey(songId)
+                    .setLength(sniffLength.toLong())
+                    .build(),
+            )
+            val magic = ByteArray(sniffLength)
+            var read = 0
+            while (read < sniffLength) {
+                val count = dataSource.read(magic, read, sniffLength - read)
+                if (count <= 0) break
+                read += count
+            }
+            mimeTypeOf(magic, read)
+        } catch (e: Exception) {
+            null
+        } finally {
+            runCatching { dataSource.close() }
+        }
+    }
+
+    private fun mimeTypeOf(magic: ByteArray, length: Int): String? = when {
+        // EBML header, i.e. WebM/Matroska - what YouTube Opus streams are wrapped in.
+        length >= 4 && magic[0] == EBML[0] && magic[1] == EBML[1] &&
+            magic[2] == EBML[2] && magic[3] == EBML[3] -> "audio/webm"
+        length >= 8 && asciiEquals(magic, 4, "ftyp") -> "audio/mp4"
+        length >= 4 && asciiEquals(magic, 0, "fLaC") -> "audio/flac"
+        length >= 4 && asciiEquals(magic, 0, "OggS") -> "audio/ogg"
+        length >= 3 && asciiEquals(magic, 0, "ID3") -> "audio/mpeg"
+        length >= 2 && magic[0] == 0xFF.toByte() && magic[1].toInt() and 0xE0 == 0xE0 -> "audio/mpeg"
+        else -> null
+    }
+
+    private fun asciiEquals(bytes: ByteArray, offset: Int, expected: String): Boolean {
+        if (bytes.size < offset + expected.length) return false
+        return expected.indices.all { bytes[offset + it] == expected[it].code.toByte() }
+    }
+
+    private companion object {
+        const val TAG = "DownloadFolderExporter"
+        const val SUBFOLDER = "Vivi"
+        const val OPEN_MODE_TRUNCATE = "wt"
+        const val PART_SUFFIX = ".part"
+        const val BUFFER_SIZE = 64 * 1024
+        const val MAGIC_SIZE = 12
+        val EBML = byteArrayOf(0x1A, 0x45, 0xDF.toByte(), 0xA3.toByte())
+    }
+}
+
+/** Maps a library row onto the metadata the template can resolve. */
+internal fun Song.toTemplateInput() = FolderTemplate.Input(
+    songId = id,
+    title = song.title,
+    artists = artists.map { it.name },
+    albumTitle = album?.title,
+    storedAlbumName = song.albumName,
+    songYear = song.year,
+    albumYear = album?.year,
+    bitrate = format?.bitrate,
+)
