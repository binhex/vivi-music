+/**
+ * vivimusic Project (C) 2026
+ * Licensed under GPL-3.0 | See git history for contributors
+ */
+
+package com.music.vivi.playback
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class DownloadRecoveryTest {
+
+    private fun policy(
+        stallTimeoutMs: Long = 10_000L,
+        slowTransferTimeoutMs: Long = 60_000L,
+        maxRestartsPerDownload: Int = 2,
+        maxRetriesPerDownload: Int = 1,
+        retryWindowMs: Long = 600_000L,
+    ) = DownloadRecoveryPolicy(
+        stallTimeoutMs = stallTimeoutMs,
+        slowTransferTimeoutMs = slowTransferTimeoutMs,
+        maxRestartsPerDownload = maxRestartsPerDownload,
+        maxRetriesPerDownload = maxRetriesPerDownload,
+        retryWindowMs = retryWindowMs,
+    )
+
+    private fun downloading(
+        id: String = "song",
+        bytes: Long = 0L,
+        online: Boolean = true,
+    ) = DownloadRecoveryObservation(
+        id = id,
+        phase = DownloadRecoveryPhase.DOWNLOADING,
+        bytesDownloaded = bytes,
+        online = online,
+    )
+
+    private fun failed(id: String = "song", online: Boolean = true) = DownloadRecoveryObservation(
+        id = id,
+        phase = DownloadRecoveryPhase.FAILED,
+        bytesDownloaded = 0L,
+        online = online,
+    )
+
+    @Test
+    fun `the default policy restarts at the documented ninety second stall`() {
+        // The literals mirror the default documented in local-patches/README.md, so changing the
+        // constant without changing the documentation fails here; the other timing tests pass their own
+        // timeouts and would not notice.
+        val policy = DownloadRecoveryPolicy()
+        val observation = DownloadRecoveryObservation("song", DownloadRecoveryPhase.DOWNLOADING, 0L)
+
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(observation, 0L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(observation, 89_999L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(observation, 90_000L))
+    }
+
+    @Test
+    fun `media3 state numbers map to the phases the policy understands`() {
+        // The numbers are Media3's public Download.STATE_* values, so the watchdog adapter needs no logic.
+        assertEquals(DownloadRecoveryPhase.QUEUED, downloadPhaseOf(0))
+        assertEquals(DownloadRecoveryPhase.STOPPED, downloadPhaseOf(1))
+        assertEquals(DownloadRecoveryPhase.DOWNLOADING, downloadPhaseOf(2))
+        assertEquals(DownloadRecoveryPhase.COMPLETED, downloadPhaseOf(3))
+        assertEquals(DownloadRecoveryPhase.FAILED, downloadPhaseOf(4))
+        assertEquals(DownloadRecoveryPhase.REMOVING, downloadPhaseOf(5))
+        assertEquals(DownloadRecoveryPhase.RESTARTING, downloadPhaseOf(7))
+        // 6 is unused by Media3, and anything unknown must be inert rather than guessed at.
+        assertEquals(DownloadRecoveryPhase.OTHER, downloadPhaseOf(6))
+        assertEquals(DownloadRecoveryPhase.OTHER, downloadPhaseOf(99))
+    }
+
+    @Test
+    fun `a downloading download that keeps making progress is left alone`() {
+        val policy = policy()
+        var now = 0L
+        var bytes = 0L
+
+        repeat(12) {
+            assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = bytes), now))
+            now += 5_000L
+            bytes += 512_000L
+        }
+    }
+
+    @Test
+    fun `a downloading download with no progress for the stall timeout is restarted`() {
+        val policy = policy(stallTimeoutMs = 10_000L)
+
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 4_096L), 0L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 4_096L), 9_999L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(downloading(bytes = 4_096L), 10_000L))
+    }
+
+    @Test
+    fun `a slow transfer that never stalls is still restarted once it outruns the total budget`() {
+        val policy = policy(stallTimeoutMs = 10_000L, slowTransferTimeoutMs = 30_000L)
+        var now = 0L
+        var bytes = 0L
+
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = bytes), now))
+        // Stop one tick short of the budget: the boundary itself is the trigger, asserted below.
+        while (now < 25_000L) {
+            now += 5_000L
+            bytes += 128_000L
+            assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = bytes), now))
+        }
+        now += 5_000L
+        bytes += 128_000L
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(downloading(bytes = bytes), now))
+    }
+
+    @Test
+    fun `an offline gap does not carry the stall clocks into the reconnect`() {
+        val policy = policy(stallTimeoutMs = 10_000L, slowTransferTimeoutMs = 60_000L)
+        val offline = DownloadRecoveryObservation("song", DownloadRecoveryPhase.QUEUED, 0L, online = false)
+
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 0L))
+        // Ten minutes with no network: Media3 parks the download in QUEUED and nothing may be charged.
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(offline, 60_000L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(offline, 600_000L))
+        // The first tick after reconnect must re-baseline instead of restarting a download that never stalled.
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 600_001L))
+    }
+
+    @Test
+    fun `a download removed between passes loses its watch so a re-download starts fresh`() {
+        val policy = policy(stallTimeoutMs = 1_000L, maxRestartsPerDownload = 1)
+
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 0L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(downloading(bytes = 0L), 1_000L))
+        // The user cancels the download, so its row is gone from the next pass of the index.
+        policy.endPass(emptySet())
+        // Re-downloading the same song is a new attempt, not one that already spent its budget.
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 2_000L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(downloading(bytes = 0L), 3_000L))
+    }
+
+    @Test
+    fun `a failure older than the retry window is left alone`() {
+        val policy = policy(retryWindowMs = 600_000L)
+        val oldFailure = DownloadRecoveryObservation(
+            "song",
+            DownloadRecoveryPhase.FAILED,
+            0L,
+            failureAgeMs = 600_001L,
+        )
+
+        // A row from a previous session must not be re-queued on every launch.
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(oldFailure, 600_001L))
+    }
+
+    @Test
+    fun `a failure inside the retry window is still retried`() {
+        val policy = policy(retryWindowMs = 600_000L)
+        val freshFailure = DownloadRecoveryObservation(
+            "song",
+            DownloadRecoveryPhase.FAILED,
+            0L,
+            failureAgeMs = 1_000L,
+        )
+
+        assertEquals(DownloadRecoveryAction.RETRY, policy.onObservation(freshFailure, 100_000L))
+    }
+
+    @Test
+    fun `the default policy restarts at the documented five minute crawl`() {
+        // The literal mirrors the default documented in local-patches/README.md, so changing the constant fails here.
+        val policy = DownloadRecoveryPolicy()
+        var now = 0L
+        var bytes = 0L
+        val slow = { bytes: Long ->
+            DownloadRecoveryObservation("slow", DownloadRecoveryPhase.DOWNLOADING, bytes)
+        }
+
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(slow(bytes), now))
+        while (now < 285_000L) {
+            now += 15_000L
+            bytes += 128_000L
+            assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(slow(bytes), now))
+        }
+        now += 15_000L
+        bytes += 128_000L
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(slow(bytes), now))
+    }
+
+    @Test
+    fun `the default policy caps restarts at two and retries at one`() {
+        val policy = DownloadRecoveryPolicy()
+        val stalled = DownloadRecoveryObservation("stalled", DownloadRecoveryPhase.DOWNLOADING, 0L)
+
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(stalled, 1_000_000L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(stalled, 1_090_000L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(stalled, 1_090_001L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(stalled, 1_180_001L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(stalled, 1_180_002L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(stalled, 5_000_000L))
+
+        val failed = DownloadRecoveryObservation(
+            "failed",
+            DownloadRecoveryPhase.FAILED,
+            0L,
+            failureAgeMs = 1L,
+        )
+        assertEquals(DownloadRecoveryAction.RETRY, policy.onObservation(failed, 5_000_001L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(failed, 5_000_002L))
+    }
+
+    @Test
+    fun `a re-created row gets its restart budget back`() {
+        // The user cancels and re-downloads inside one watch interval; Media3 gives the new row a fresh
+        // start time, so the new attempt must not inherit the two restarts the old one spent.
+        val policy = policy(stallTimeoutMs = 1_000L, maxRestartsPerDownload = 1)
+        val first = { phase: DownloadRecoveryPhase, startedAt: Long ->
+            DownloadRecoveryObservation(
+                "song",
+                phase,
+                0L,
+                rowStartedAtMs = startedAt,
+            )
+        }
+
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(first(DownloadRecoveryPhase.DOWNLOADING, 100L), 0L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(first(DownloadRecoveryPhase.DOWNLOADING, 100L), 1_000L))
+        // New row, new start time: the attempt starts over with a full restart budget.
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(first(DownloadRecoveryPhase.DOWNLOADING, 500L), 1_100L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(first(DownloadRecoveryPhase.DOWNLOADING, 500L), 2_100L))
+    }
+
+    @Test
+    fun `a re-created row does not get its retry budget back`() {
+        // Media3 only rebuilds a start time when it merges a terminal row, which is what the watchdog's own
+        // retry does, so the retry cap must survive a start-time change - otherwise a failing download would
+        // be retried forever inside one session.
+        val policy = policy(maxRetriesPerDownload = 1)
+        val failed = { startedAt: Long ->
+            DownloadRecoveryObservation(
+                "song",
+                DownloadRecoveryPhase.FAILED,
+                0L,
+                failureAgeMs = 0L,
+                rowStartedAtMs = startedAt,
+            )
+        }
+
+        assertEquals(DownloadRecoveryAction.RETRY, policy.onObservation(failed(100L), 0L))
+        // Media3 resets startTimeMs when it merges this terminal row, which is what our retry did.
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(failed(500L), 1_000L))
+    }
+
+    @Test
+    fun `a failure from a previous session is not retried`() {
+        val policy = policy()
+        val oldFailure = DownloadRecoveryObservation(
+            "song",
+            DownloadRecoveryPhase.FAILED,
+            0L,
+            failureAgeMs = 1_000L,
+            failureIsFromThisSession = false,
+        )
+
+        // Every launch would otherwise re-queue a download that keeps failing, because each new failure
+        // refreshes the row's timestamp and the retry budget only lives as long as the process.
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(oldFailure, 0L))
+    }
+
+    @Test
+    fun `a frozen process noticing a rebuild late still does not refill the retry budget`() {
+        // Timing cannot tell the watchdog's own retry apart from a user's re-download: a process that was
+        // frozen for minutes first sees either one late. The budget is therefore per session, and a rebuild
+        // never refills it.
+        val policy = policy(maxRetriesPerDownload = 1)
+        val failed = { startedAt: Long ->
+            DownloadRecoveryObservation(
+                "song",
+                DownloadRecoveryPhase.FAILED,
+                0L,
+                failureAgeMs = 0L,
+                rowStartedAtMs = startedAt,
+            )
+        }
+
+        assertEquals(DownloadRecoveryAction.RETRY, policy.onObservation(failed(100L), 0L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(failed(500L), 1_000L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(failed(900L), 600_000L))
+    }
+
+    @Test
+    fun `a skipped action gives its budget back`() {
+        val policy = policy(stallTimeoutMs = 1_000L, maxRestartsPerDownload = 1)
+
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 0L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(downloading(bytes = 0L), 1_000L))
+        // The caller found the download had moved on and did nothing, so the budget must not be lost.
+        policy.onActionSkipped("song")
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 1_100L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(downloading(bytes = 0L), 2_100L))
+    }
+
+    @Test
+    fun `the policy refuses budgets that would silently disable its rules`() {
+        val invalid = listOf<() -> Any>(
+            { DownloadRecoveryPolicy(stallTimeoutMs = 0L) },
+            { DownloadRecoveryPolicy(slowTransferTimeoutMs = 0L) },
+            { DownloadRecoveryPolicy(maxRestartsPerDownload = 0) },
+            { DownloadRecoveryPolicy(maxRetriesPerDownload = 0) },
+            { DownloadRecoveryPolicy(retryWindowMs = 0L) },
+        )
+        invalid.forEach { construct ->
+            try {
+                construct()
+                throw AssertionError("a non-positive budget was accepted: $construct")
+            } catch (expected: IllegalArgumentException) {
+                // Correct: a zero budget is a misconfiguration, not a policy.
+            }
+        }
+    }
+
+    @Test
+    fun `a queued download is never restarted`() {
+        val policy = policy(stallTimeoutMs = 1_000L, slowTransferTimeoutMs = 2_000L)
+        val queued = DownloadRecoveryObservation(id = "song", phase = DownloadRecoveryPhase.QUEUED, bytesDownloaded = 0L)
+
+        var now = 0L
+        repeat(10) {
+            assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(queued, now))
+            now += 10_000L
+        }
+    }
+
+    @Test
+    fun `nothing is restarted or retried while the device is offline`() {
+        val policy = policy(stallTimeoutMs = 1_000L, slowTransferTimeoutMs = 2_000L)
+
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L, online = false), 0L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L, online = false), 600_000L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(failed(online = false), 600_000L))
+    }
+
+    @Test
+    fun `a failed download is retried once`() {
+        val policy = policy()
+
+        assertEquals(DownloadRecoveryAction.RETRY, policy.onObservation(failed(), 0L))
+    }
+
+    @Test
+    fun `a failed download is not retried a second time`() {
+        val policy = policy(maxRetriesPerDownload = 1)
+
+        assertEquals(DownloadRecoveryAction.RETRY, policy.onObservation(failed(), 0L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(failed(), 1_000L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(failed(), 60_000L))
+    }
+
+    @Test
+    fun `restarts are capped per download so a broken file cannot loop forever`() {
+        val policy = policy(stallTimeoutMs = 1_000L, slowTransferTimeoutMs = 5_000L, maxRestartsPerDownload = 2)
+
+        // Each restart re-baselines the clock, so drive it through a fresh stall three times.
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 0L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(downloading(bytes = 0L), 1_000L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 2_000L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(downloading(bytes = 0L), 3_000L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 4_000L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 9_999_999L))
+    }
+
+    @Test
+    fun `a download missing from a pass is forgotten so a later download starts fresh`() {
+        val policy = policy(stallTimeoutMs = 1_000L, maxRestartsPerDownload = 1)
+
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 0L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(downloading(bytes = 0L), 1_000L))
+        // The row is no longer in the index the adapter reads, which is what a finished or removed download
+        // looks like from here; the adapter prunes everything the pass did not see.
+        policy.endPass(emptySet())
+
+        // Re-downloading the same song later is a new watch, not a spent budget.
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 2_000L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(downloading(bytes = 0L), 3_000L))
+    }
+
+    @Test
+    fun `bytes going backwards counts as progress and resets the stall clock`() {
+        val policy = policy(stallTimeoutMs = 1_000L)
+
+        // A re-download can report fewer bytes than the attempt before it; that change must count as progress
+        // rather than leave the stall clock running from the old byte count.
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 500_000L), 0L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 100_000L), 500L))
+        // Without that reset this tick is 1_400 ms after the first observation and would be a stall.
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 100_000L), 1_400L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(downloading(bytes = 100_000L), 1_501L))
+    }
+
+    @Test
+    fun `a failure exactly at the retry window is still retried`() {
+        val policy = policy(retryWindowMs = 600_000L)
+        val atBoundary = DownloadRecoveryObservation(
+            "song",
+            DownloadRecoveryPhase.FAILED,
+            0L,
+            failureAgeMs = 600_000L,
+        )
+
+        // The window is exclusive: the age has to exceed it to disqualify the retry.
+        assertEquals(DownloadRecoveryAction.RETRY, policy.onObservation(atBoundary, 0L))
+    }
+
+    @Test
+    fun `a spent budget survives the download being parked in the queue`() {
+        val policy = policy(stallTimeoutMs = 1_000L, maxRestartsPerDownload = 1, maxRetriesPerDownload = 1)
+        val queued = DownloadRecoveryObservation("song", DownloadRecoveryPhase.QUEUED, 0L)
+        val failed = DownloadRecoveryObservation(
+            "song",
+            DownloadRecoveryPhase.FAILED,
+            0L,
+            failureAgeMs = 0L,
+        )
+
+        // A restart parks the row in QUEUED while Media3 cancels the old task and starts a new one, and the
+        // adapter reads queued rows precisely so this does not hand the restart budget back.
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 0L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(downloading(bytes = 0L), 1_000L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(queued, 1_100L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 1_200L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(bytes = 0L), 2_300L))
+
+        // Same for the retry budget: one retry, then neither a queued interlude nor another failure re-arms it.
+        assertEquals(DownloadRecoveryAction.RETRY, policy.onObservation(failed, 2_400L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(queued, 2_500L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(failed, 2_600L))
+    }
