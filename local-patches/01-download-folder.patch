+/**
+ * vivimusic Project (C) 2026
+ * Licensed under GPL-3.0 | See git history for contributors
+ */
+
+package com.music.vivi.playback
+
+import android.content.Context
+import android.database.Cursor
+import android.net.Uri
+import android.provider.DocumentsContract
+
+/**
+ * The handful of Storage Access Framework calls this patch needs for the single folder the user
+ * picks in Storage settings.
+ *
+ * Hand-rolled instead of using `androidx.documentfile`, which is a thin wrapper over exactly these
+ * calls: that keeps the patch dependency-free, so it never has to touch the Gradle files either.
+ *
+ * Everything here addresses documents through `buildDocumentUriUsingTree`, never the bare
+ * `content://.../tree/<id>` URI that `ACTION_OPEN_DOCUMENT_TREE` hands back: a tree URI on its own
+ * matches none of the URI shapes `DocumentsProvider.query()` serves, so querying it throws.
+ */
+internal object SafFolders {
+
+    /** Display name of the picked folder, or null when the grant is gone or the folder is unreadable. */
+    fun displayName(context: Context, treeUri: Uri): String? =
+        query(context, documentUri(treeUri), arrayOf(DocumentsContract.Document.COLUMN_DISPLAY_NAME)) {
+            it.getString(0)
+        }
+
+    /**
+     * Returns a writable document URI for [displayName] inside the tree, replacing an existing file
+     * of that name when the provider allows deleting it. Null means the folder refused the write.
+     *
+     * When the delete is refused the existing document is returned instead: callers open it in
+     * truncating mode, so a re-download still overwrites rather than appending.
+     */
+    fun createOrReplaceFile(
+        context: Context,
+        treeUri: Uri,
+        mimeType: String,
+        displayName: String,
+    ): Uri? {
+        val existing = findFile(context, treeUri, displayName)
+        if (existing != null) {
+            val deleted = runCatching {
+                DocumentsContract.deleteDocument(context.contentResolver, existing)
+            }.getOrDefault(false)
+            if (!deleted) return existing
+        }
+        return runCatching {
+            DocumentsContract.createDocument(
+                context.contentResolver,
+                documentUri(treeUri),
+                mimeType,
+                displayName,
+            )
+        }.getOrNull()
+    }
+
+    /** Best-effort delete, used to clean up a half-written export. */
+    fun delete(context: Context, documentUri: Uri) {
+        runCatching { DocumentsContract.deleteDocument(context.contentResolver, documentUri) }
+    }
+
+    private fun findFile(context: Context, treeUri: Uri, displayName: String): Uri? =
+        query(
+            context,
+            DocumentsContract.buildChildDocumentsUriUsingTree(
+                treeUri,
+                DocumentsContract.getTreeDocumentId(treeUri),
+            ),
+            arrayOf(
+                DocumentsContract.Document.COLUMN_DOCUMENT_ID,
+                DocumentsContract.Document.COLUMN_DISPLAY_NAME,
+            ),
+        ) { cursor ->
+            var match: Uri? = null
+            while (cursor.moveToNext()) {
+                if (cursor.getString(1) == displayName) {
+                    match = DocumentsContract.buildDocumentUriUsingTree(treeUri, cursor.getString(0))
+                    break
+                }
+            }
+            match
+        }
+
+    private fun documentUri(treeUri: Uri): Uri =
+        DocumentsContract.buildDocumentUriUsingTree(
+            treeUri,
+            DocumentsContract.getTreeDocumentId(treeUri),
+        )
+
+    private fun <T> query(
+        context: Context,
+        uri: Uri,
+        columns: Array<String>,
+        read: (Cursor) -> T,
+    ): T? = runCatching {
+        context.contentResolver.query(uri, columns, null, null, null)?.use { cursor ->
+            if (cursor.moveToFirst()) read(cursor) else null
+        }
+    }.getOrNull()
+}
