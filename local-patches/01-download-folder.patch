+    @Test
+    fun `resolved segments separate what a template contributes from the cap`() {
+        // Seven tokens that resolve to nothing contribute no folder at all, so nothing was dropped.
+        val tokensOnly = (1..7).joinToString("/") { "%tracknumber%" }
+        assertTrue(DownloadFormat.expand(input(trackNumber = null), tokensOnly).isEmpty())
+        assertTrue(DownloadFormat.resolvedSegments(input(trackNumber = null), tokensOnly).isEmpty())
+        // Seven segments that do resolve are capped by expand, and the uncapped count says so.
+        val realFolders = (1..7).joinToString("/") { "%artist%" }
+        assertEquals(7, DownloadFormat.resolvedSegments(input(), realFolders).size)
+        assertEquals(DownloadFormat.MAX_SEGMENTS, DownloadFormat.expand(input(), realFolders).size)
+    }
