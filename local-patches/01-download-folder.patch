+package com.music.vivi.playback
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class FolderTemplateTest {
+
+    private fun input(
+        songId: String = "dQw4w9WgXcQ",
+        title: String? = "Enter Sandman",
+        artists: List<String> = listOf("Metallica"),
+        albumTitle: String? = "Master Of Puppets",
+        storedAlbumName: String? = null,
+        songYear: Int? = 1986,
+        albumYear: Int? = null,
+        bitrate: Int? = 256_000,
+    ) = FolderTemplate.Input(
+        songId = songId,
+        title = title,
+        artists = artists,
+        albumTitle = albumTitle,
+        storedAlbumName = storedAlbumName,
+        songYear = songYear,
+        albumYear = albumYear,
+        bitrate = bitrate,
+    )
+
+    @Test
+    fun `parse reports unknown tokens in the spelling the user typed`() {
+        val result = FolderTemplate.parse("%artist%/%genre%/%BOGUS%")
