+
+package com.music.vivi.playback
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class DownloadFormatTest {
+
+    private fun input(
+        songId: String = "dQw4w9WgXcQ",
+        title: String? = "Enter Sandman",
+        artists: List<String> = listOf("Metallica"),
+        albumTitle: String? = "Master Of Puppets",
+        storedAlbumName: String? = null,
+        songYear: Int? = 1986,
+        albumYear: Int? = null,
+        bitrate: Int? = 256_000,
+        trackNumber: Int? = null,
+    ) = DownloadFormat.Input(
+        songId = songId,
+        title = title,
+        artists = artists,
+        albumTitle = albumTitle,
+        storedAlbumName = storedAlbumName,
+        songYear = songYear,
+        albumYear = albumYear,
+        bitrate = bitrate,
+        trackNumber = trackNumber,
+    )
+
+    @Test
+    fun `parse reports unknown tokens in the spelling the user typed`() {
+        val result = DownloadFormat.parse("%artist%/%genre%/%BOGUS%")
+        assertEquals(listOf("%genre%", "%BOGUS%"), result.unknownTokens)
+        assertFalse(result.isValid)
+    }
+
+    @Test
+    fun `parse accepts the default template`() {
+        assertTrue(DownloadFormat.parse(DownloadFormat.DEFAULT_FOLDER_TEMPLATE).isValid)
+    }
+
+    @Test
+    fun `parse is case insensitive`() {
+        assertTrue(DownloadFormat.parse("%ARTIST%/%Album%").isValid)
+    }
+
+    @Test
+    fun `parse flags a too deep template without invalidating it`() {
+        val result = DownloadFormat.parse((1..7).joinToString("/") { "%artist%" })
+        assertTrue(result.tooDeep)
+        assertTrue(result.isValid)
+    }
+
+    @Test
+    fun `parse does not count segments that can never be used`() {
+        val result = DownloadFormat.parse("%artist%/..///%album%/%year%/%title%/%songId%/%quality%")
+        assertFalse(result.tooDeep)
+        assertTrue(result.isValid)
+    }
+
+    @Test
+    fun `parse flags a token the pattern cannot consume`() {
+        assertEquals(listOf("%genre"), DownloadFormat.parse("%artist%/%genre").unknownTokens)
+        assertEquals(listOf("%%"), DownloadFormat.parse("%%artist%%").unknownTokens)
+    }
+
+    @Test
+    fun `parse accepts a literal percent in a name`() {
+        assertTrue(DownloadFormat.parse("%artist%/%album% - 100% Hits").isValid)
+        assertTrue(DownloadFormat.parse("100% Hits/%artist%").isValid)
+    }
+
+    @Test
+    fun `parse accepts an empty template`() {
+        assertTrue(DownloadFormat.parse("").isValid)
+        assertFalse(DownloadFormat.parse("").tooDeep)
+    }
+
+    @Test
+    fun `parse accepts the track number token`() {
+        assertTrue(DownloadFormat.parse("%tracknumber% - %title%").isValid)
+        assertTrue(DownloadFormat.TOKENS.contains("%tracknumber%"))
+    }
+
+    @Test
+    fun `templateOrDefault keeps an unset template at the default and an emptied one flat`() {
+        assertEquals(DownloadFormat.DEFAULT_FOLDER_TEMPLATE, DownloadFormat.templateOrDefault(null))
+        assertEquals("", DownloadFormat.templateOrDefault(""))
+        assertEquals("%year%", DownloadFormat.templateOrDefault("%year%"))
+    }
+
+    @Test
+    fun `file template defaults when unset, emptied or blank`() {
+        assertEquals(DownloadFormat.DEFAULT_FILE_TEMPLATE, DownloadFormat.fileTemplateOrDefault(null))
+        assertEquals(DownloadFormat.DEFAULT_FILE_TEMPLATE, DownloadFormat.fileTemplateOrDefault(""))
+        assertEquals(DownloadFormat.DEFAULT_FILE_TEMPLATE, DownloadFormat.fileTemplateOrDefault("   "))
+        assertEquals("%title%", DownloadFormat.fileTemplateOrDefault("%title%"))
+    }
+
+    @Test
+    fun `every supported token resolves`() {
+        assertEquals(
+            listOf("Metallica", "Master Of Puppets", "1986", "Enter Sandman", "dQw4w9WgXcQ", "256kbps"),
+            DownloadFormat.expand(input(), "%artist%/%album%/%year%/%title%/%songId%/%quality%"),
+        )
+    }
+
+    @Test
+    fun `tokens are case insensitive when expanding`() {
+        assertEquals(listOf("Metallica"), DownloadFormat.expand(input(), "%ARTIST%"))
+    }
+
+    @Test
+    fun `unknown token is kept literally, including its case`() {
+        assertEquals(listOf("%genre%"), DownloadFormat.expand(input(), "%genre%"))
+        assertEquals(listOf("%GENRE%"), DownloadFormat.expand(input(), "%GENRE%"))
+    }
+
+    @Test
+    fun `missing artist falls back`() {
+        assertEquals(listOf("Unknown Artist"), DownloadFormat.expand(input(artists = emptyList()), "%artist%"))
+    }
+
+    @Test
+    fun `missing album falls back`() {
+        assertEquals(
+            listOf("Unknown Album"),
+            DownloadFormat.expand(input(albumTitle = null, storedAlbumName = null), "%album%"),
+        )
+    }
+
+    @Test
+    fun `album falls back to the stored album name and prefers the album title`() {
+        assertEquals(
+            listOf("Master Of Puppets"),
+            DownloadFormat.expand(input(albumTitle = null, storedAlbumName = "Master Of Puppets"), "%album%"),
+        )
+        assertEquals(
+            listOf("Master Of Puppets"),
+            DownloadFormat.expand(input(albumTitle = "Master Of Puppets", storedAlbumName = "Other"), "%album%"),
+        )
+    }
+
+    @Test
+    fun `missing year falls back`() {
+        assertEquals(
+            listOf("Unknown Year"),
+            DownloadFormat.expand(input(songYear = null, albumYear = null), "%year%"),
+        )
+    }
+
+    @Test
+    fun `year falls back to the album year and prefers the song year`() {
+        assertEquals(listOf("1986"), DownloadFormat.expand(input(songYear = null, albumYear = 1986), "%year%"))
+        assertEquals(listOf("1991"), DownloadFormat.expand(input(songYear = 1991, albumYear = 1986), "%year%"))
+    }
+
+    @Test
+    fun `missing bitrate falls back`() {
+        assertEquals(listOf("Unknown Quality"), DownloadFormat.expand(input(bitrate = null), "%quality%"))
+        assertEquals(listOf("Unknown Quality"), DownloadFormat.expand(input(bitrate = 0), "%quality%"))
+    }
+
+    @Test
+    fun `bitrate below one kilobit per second floors to zero kbps`() {
+        assertEquals(listOf("0kbps"), DownloadFormat.expand(input(bitrate = 999), "%quality%"))
+    }
+
+    @Test
+    fun `blank title falls back to the song id`() {
+        assertEquals(listOf("dQw4w9WgXcQ"), DownloadFormat.expand(input(title = "  "), "%title%"))
+    }
+
+    @Test
+    fun `multiple artists are joined`() {
+        assertEquals(
+            listOf("Metallica, Jason Newsted"),
+            DownloadFormat.expand(input(artists = listOf("Metallica", "Jason Newsted")), "%artist%"),
+        )
+    }
+
+    @Test
+    fun `a slash inside a resolved value stays in one segment`() {
+        assertEquals(listOf("AC_DC"), DownloadFormat.expand(input(artists = listOf("AC/DC")), "%artist%"))
+    }
+
+    @Test
+    fun `a backslash inside a resolved value stays in one segment`() {
+        assertEquals(listOf("AC_DC"), DownloadFormat.expand(input(artists = listOf("AC\\DC")), "%artist%"))
+    }
+
+    @Test
+    fun `backslash separates segments`() {
+        assertEquals(
+            listOf("Metallica", "Master Of Puppets"),
+            DownloadFormat.expand(input(), "%artist%\\%album%"),
+        )
+    }
+
+    @Test
+    fun `empty template produces no segments`() {
+        assertTrue(DownloadFormat.expand(input(), "").isEmpty())
+        assertTrue(DownloadFormat.expand(input(), "  /  ").isEmpty())
+    }
+
+    @Test
+    fun `dots only segment is dropped`() {
+        assertTrue(DownloadFormat.expand(input(title = ".."), "%title%").isEmpty())
+        assertTrue(DownloadFormat.expand(input(title = "."), "%title%").isEmpty())
+    }
+
+    @Test
+    fun `absolute looking template stays relative`() {
