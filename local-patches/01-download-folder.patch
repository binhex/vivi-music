+++ b/app/src/main/kotlin/com/music/vivi/playback/FolderTemplate.kt
@@ -0,0 +1,177 @@
+/**
+ * vivimusic Project (C) 2026
+ * Licensed under GPL-3.0 | See git history for contributors
+ */
+
+package com.music.vivi.playback
+
+/**
+ * Turns the download folder structure template into sanitised path segments, and composes the file name
+ * for an export.
+ *
+ * Deliberately pure Kotlin with no Android or database imports: these are the rules that decide where a
+ * file lands on disk, including the traversal safety, so they are unit-tested directly.
+ */
+object FolderTemplate {
+
+    /** Organise downloads by artist and album unless the user says otherwise. */
+    const val DEFAULT_TEMPLATE = "%artist%/%album%"
+
+    /** A pathological template must not be able to build an unbounded tree. */
+    const val MAX_SEGMENTS = 6
+
+    /** Filesystems cap a single name at 255 bytes; leave room for the extension. */
+    const val MAX_SEGMENT_BYTES = 200
+
+    /** The same budget applies to a composed file name. */
+    const val MAX_FILE_NAME_BYTES = 200
+
+    /** Longest extension this app writes (`.webm`, `.flac`), reserved out of [MAX_FILE_NAME_BYTES]. */
+    private const val MAX_EXTENSION_BYTES = 5
+
+    const val DEFAULT_MIME_TYPE = "audio/mp4"
+
+    /** Tokens offered as chips in the editor, in display order. */
+    val TOKENS = listOf("%artist%", "%album%", "%year%", "%title%", "%songId%", "%quality%")
+
+    private val SUPPORTED = setOf("artist", "album", "year", "title", "songid", "quality")
+    private val TOKEN_PATTERN = Regex("%([A-Za-z]+)%")
+    private val INVALID_CHARS = Regex("[\\\\/:*?\"<>|]")
+    private val WHITESPACE = Regex("\\s+")
+
+    private const val UNKNOWN_ARTIST = "Unknown Artist"
+    private const val UNKNOWN_ALBUM = "Unknown Album"
+    private const val UNKNOWN_YEAR = "Unknown Year"
+    private const val UNKNOWN_QUALITY = "Unknown Quality"
+
+    /**
+     * The metadata a template can resolve, decoupled from the database entities.
+     *
+     * Both album names and both years are carried so the precedence rules live here, in the tested unit,
+     * instead of in the caller.
+     */
+    data class Input(
+        val songId: String,
+        val title: String?,
+        val artists: List<String>,
+        val albumTitle: String?,
+        val storedAlbumName: String?,
+        val songYear: Int?,
+        val albumYear: Int?,
+        val bitrate: Int?,
+    )
+
+    /** Validation outcome for the settings editor. [unknownTokens] keeps the spelling the user typed. */
+    data class ParseResult(
+        val unknownTokens: List<String>,
+        val tooDeep: Boolean,
+    ) {
+        val isValid: Boolean get() = unknownTokens.isEmpty()
+    }
+
+    /**
+     * Resolves the stored preference: an unset value means the default template, while a stored empty
+     * string means the user asked for flat output.
+     */
+    fun templateOrDefault(stored: String?): String = stored ?: DEFAULT_TEMPLATE
+
+    /** Reports tokens the app cannot resolve, plus whether the template uses more than [MAX_SEGMENTS]. */
+    fun parse(template: String): ParseResult {
+        val segments = normalise(template)
+        val unknown = segments
+            .flatMap { segment -> TOKEN_PATTERN.findAll(segment).map { it.value } }
+            .filterNot { it.drop(1).dropLast(1).lowercase() in SUPPORTED }
+            .distinct()
+        // Count the segments this template will really contribute. Tokens are unresolved here, so a token
+        // that resolves to nothing at export time can still make this count one too high.
+        val usable = segments.count { sanitizeSegment(it).isNotEmpty() }
+        return ParseResult(unknown, usable > MAX_SEGMENTS)
+    }
+
+    /** Resolves [template] into the folder segments to create below the download root. */
+    fun expand(input: Input, template: String): List<String> = normalise(template)
+        .map { segment -> substitute(segment, input) }
+        .map(::sanitizeSegment)
+        .filter { it.isNotEmpty() }
+        .take(MAX_SEGMENTS)
+
+    /** Sanitised `Artist - Title`, without an extension. */
+    fun fileNameBase(input: Input): String {
+        // Each part is sanitised on its own first: a title that sanitises away (dots only) must fall back
+        // to the song id rather than leaving a dangling separator behind, and an imported id can contain
+        // characters that are illegal in a file name.
+        val artist = sanitizeSegment(input.artists.joinToString(", ")).ifBlank { UNKNOWN_ARTIST }
+        val title = sanitizeSegment(input.title.orEmpty()).ifBlank { sanitizeSegment(input.songId) }
+        val base = truncateToBytes(
+            "$artist - $title",
+            MAX_FILE_NAME_BYTES - MAX_EXTENSION_BYTES,
+        ).trimEnd('.', ' ')
+        return base
+    }
+
+    /** `Artist - Title.ext`, the name the exporter writes. */
+    fun fileName(input: Input, mimeType: String?): String =
+        "${fileNameBase(input)}${extensionFor(mimeType)}"
+
+    private fun substitute(segment: String, input: Input): String =
+        TOKEN_PATTERN.replace(segment) { match -> resolve(match.groupValues[1].lowercase(), match.value, input) }
+
+    /**
+     * [literal] is the token exactly as the user wrote it, so an unsupported token keeps its original
+     * spelling instead of being folded to lower case.
+     */
+    private fun resolve(token: String, literal: String, input: Input): String = when (token) {
+        "artist" -> input.artists.joinToString(", ").ifBlank { UNKNOWN_ARTIST }
+        "album" -> (input.albumTitle ?: input.storedAlbumName).orEmpty().ifBlank { UNKNOWN_ALBUM }
+        "year" -> (input.songYear ?: input.albumYear)?.toString() ?: UNKNOWN_YEAR
+        "title" -> input.title.orEmpty().ifBlank { input.songId }
+        "songid" -> input.songId
+        "quality" -> input.bitrate?.takeIf { it > 0 }?.let { "${it / 1000}kbps" } ?: UNKNOWN_QUALITY
+        else -> literal
+    }
+
+    /** Backslash is a path separator too, so a Windows-style template behaves the same. */
+    private fun normalise(template: String): List<String> = template.replace('\\', '/').split('/')
+
+    /**
+     * One path segment, safe to use as a folder or file name: separators and other invalid characters
+     * become `_`, whitespace collapses, and a segment that is empty or only dots is dropped - which is
+     * what makes `..` impossible as a segment.
+     *
+     * Truncation happens before the trailing-dot strip, so a segment that is cut to the byte budget can
+     * never end in a dot or a space either.
+     */
+    internal fun sanitizeSegment(segment: String): String {
+        val cleaned = segment
+            .replace(INVALID_CHARS, "_")
+            .replace(WHITESPACE, " ")
+            .trim()
+        if (cleaned.isEmpty() || cleaned.all { it == '.' }) return ""
+        return truncateToBytes(cleaned, MAX_SEGMENT_BYTES).trimEnd('.', ' ')
+    }
+
+    /**
+     * Filesystems limit a name to 255 bytes, not characters. The cut is made on a code point boundary so
+     * the result is always valid UTF-8 and never contains half a surrogate pair.
+     */
+    internal fun truncateToBytes(name: String, maxBytes: Int): String {
+        val bytes = name.toByteArray(Charsets.UTF_8)
+        if (bytes.size <= maxBytes) return name
+        var end = maxBytes
+        while (end > 0 && bytes[end].toInt() and 0xC0 == 0x80) end--
+        return String(bytes, 0, end, Charsets.UTF_8)
+    }
+
+    internal fun extensionFor(mimeType: String?): String {
+        val type = mimeType.orEmpty().substringBefore(';').trim().ifEmpty { DEFAULT_MIME_TYPE }
+        return when {
+            type.contains("webm") -> ".webm"
+            type.contains("mp4") || type.contains("aac") -> ".m4a"
+            type.contains("mpeg") -> ".mp3"
+            type.contains("opus") -> ".opus"
+            type.contains("ogg") -> ".ogg"
+            type.contains("flac") -> ".flac"
+            else -> ".m4a"
+        }
+    }
+}
