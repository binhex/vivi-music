+/**
+ * vivimusic Project (C) 2026
+ * Licensed under GPL-3.0 | See git history for contributors
+ */
+
+package com.music.vivi.playback
+
+/** How often the watchdog looks at the download index. */
+internal const val DOWNLOAD_WATCH_INTERVAL_MS = 15_000L
+
+/** How long a download may make no progress at all before it is restarted. */
+internal const val DOWNLOAD_STALL_TIMEOUT_MS = 90_000L
+
+/** How long a download may run in total before it is restarted even if it is slowly progressing. */
+internal const val DOWNLOAD_SLOW_TRANSFER_TIMEOUT_MS = 5 * 60 * 1_000L
+
+/** How many restarts one download gets before the watchdog leaves it alone. */
+internal const val DOWNLOAD_MAX_RESTARTS = 2
+
+/** How many automatic retries a failed download gets. */
+internal const val DOWNLOAD_MAX_RETRIES = 1
+
+/** How old a failure may be and still be retried; a row outlives the process, so this bounds every launch. */
+internal const val DOWNLOAD_RETRY_WINDOW_MS = 10 * 60 * 1_000L
+
+
+/** What the watchdog should do about a download, if anything. */
+internal enum class DownloadRecoveryAction { NONE, RESTART, RETRY }
+
+/** The download states this policy cares about, free of Media3 types so the policy stays a pure unit. */
+internal enum class DownloadRecoveryPhase { QUEUED, DOWNLOADING, COMPLETED, FAILED, STOPPED, REMOVING, RESTARTING, OTHER }
+
+/** One download as the watchdog last saw it. */
+internal data class DownloadRecoveryObservation(
+    val id: String,
+    val phase: DownloadRecoveryPhase,
+    val bytesDownloaded: Long,
+    /** False when the device has no usable network, which suspends every recovery decision. */
+    val online: Boolean = true,
+    /**
+     * How long ago the failure happened, already measured on the wall clock by the adapter, or null when
+     * unknown. An age rather than a timestamp on purpose: Media3's row timestamps come from
+     * `System.currentTimeMillis()` while this policy's clock is monotonic, so comparing the two directly
+     * would silently disable the retry window.
+     */
+    val failureAgeMs: Long? = null,
+    /**
+     * False when the failure happened before this process started watching, which is the only way a retry
+     * budget that lives in memory can be spent across launches: every new failure refreshes the row's
+     * timestamp, so the age alone would let a download that keeps failing be re-queued once per launch.
+     */
+    val failureIsFromThisSession: Boolean = true,
+    /**
+     * Media3's start time for this row. A different value means the row was re-created - the user removed and
+     * re-downloaded, or a merge rebuilt it as a new download - which is a new attempt as far as the restart
+     * budget goes; the retry budget is per session and survives it.
+     */
+    val rowStartedAtMs: Long? = null,
+)
+
+// Media3's public Download.STATE_* numbers, restated here so this file needs no Media3 import.
+private const val MEDIA3_STATE_QUEUED = 0
+private const val MEDIA3_STATE_STOPPED = 1
+private const val MEDIA3_STATE_DOWNLOADING = 2
+private const val MEDIA3_STATE_COMPLETED = 3
+private const val MEDIA3_STATE_FAILED = 4
+private const val MEDIA3_STATE_REMOVING = 5
+private const val MEDIA3_STATE_RESTARTING = 7
+
+/**
+ * Maps a Media3 `Download.STATE_*` number onto [DownloadRecoveryPhase].
+ *
+ * The mapping lives here rather than in the Android-side watchdog so that the watchdog has no branching
+ * of its own and every state - including the unused 6 and any future value - is pinned by a unit test
+ * instead of being guessed at on a device.
+ */
+internal fun downloadPhaseOf(state: Int): DownloadRecoveryPhase = when (state) {
+    MEDIA3_STATE_QUEUED -> DownloadRecoveryPhase.QUEUED
+    MEDIA3_STATE_STOPPED -> DownloadRecoveryPhase.STOPPED
+    MEDIA3_STATE_DOWNLOADING -> DownloadRecoveryPhase.DOWNLOADING
+    MEDIA3_STATE_COMPLETED -> DownloadRecoveryPhase.COMPLETED
+    MEDIA3_STATE_FAILED -> DownloadRecoveryPhase.FAILED
+    MEDIA3_STATE_REMOVING -> DownloadRecoveryPhase.REMOVING
+    MEDIA3_STATE_RESTARTING -> DownloadRecoveryPhase.RESTARTING
+    else -> DownloadRecoveryPhase.OTHER
+}
+
+/**
+ * Decides when a download that is making no progress - or crawling - should be restarted, and when a
+ * failed download should be retried, so that a stalled or crawling download is recovered instead of sitting
+ * in a downloading state unnoticed. Its actions are bounded (see below), so it shortens a stall rather than
+ * promising to eliminate one.
+ *
+ * Why this exists: Media3's `DownloadManager` retries a failing download, but its retry counter resets
+ * whenever any bytes arrive, and neither it nor the app has a wall-clock deadline. A transfer that
+ * trickles, or that keeps expiring its stream URL, therefore cycles inside `STATE_DOWNLOADING` for
+ * minutes while the UI shows a spinner and the listener reports nothing (Media3 does not deliver
+ * progress to listeners). This policy is the missing deadline.
+ *
+ * The rules, all of them bounded:
+ *
+ * - A download that makes no progress for [stallTimeoutMs] is restarted.
+ * - A download that is still running after [slowTransferTimeoutMs], even while progressing slowly, is
+ *   restarted too - a crawling transfer is what a stalled one looks like from the outside.
+ * - A failed download is retried [maxRetriesPerDownload] time(s).
+ * - Queued, stopped and restarting downloads are never touched: they can be legitimately waiting for
+ *   the network, for `maxParallelDownloads`, or for a service restart.
+ * - Nothing at all happens while the device is offline, so recovery never churns without a network.
+ * - Restarts are capped by [maxRestartsPerDownload], so a genuinely broken file is left alone instead
+ *   of looping forever.
+ * - A failure is only retried while it is younger than [retryWindowMs] **and** happened while this watch was
+ *   running, so a download that keeps failing is not re-queued (and re-notified) on every app launch - its
+ *   in-memory retry budget would otherwise be refilled by every launch.
+ * - [endPass] forgets any download that disappeared from the index, and a re-created row (a different
+ *   `startTimeMs`) resets the restart budget, so a re-download is never held back by a spent budget - while
+ *   the retry budget survives, because the watchdog's own retry also re-creates the row.
+ *
+ * A restart preserves the bytes already in the download cache (Media3 re-queues the download and the
+ * cache serves the finished prefix), so none of these actions loses work.
+ */
+internal class DownloadRecoveryPolicy(
+    private val stallTimeoutMs: Long = DOWNLOAD_STALL_TIMEOUT_MS,
+    private val slowTransferTimeoutMs: Long = DOWNLOAD_SLOW_TRANSFER_TIMEOUT_MS,
+    private val maxRestartsPerDownload: Int = DOWNLOAD_MAX_RESTARTS,
+    private val maxRetriesPerDownload: Int = DOWNLOAD_MAX_RETRIES,
+    private val retryWindowMs: Long = DOWNLOAD_RETRY_WINDOW_MS,
+) {
+    init {
+        // A zero or negative budget would silently stop the policy acting while still spending its clocks,
+        // which looks exactly like a download that has not stalled yet. Fail loudly instead.
+        require(stallTimeoutMs > 0) { "stallTimeoutMs must be positive" }
+        require(slowTransferTimeoutMs > 0) { "slowTransferTimeoutMs must be positive" }
+        require(maxRestartsPerDownload > 0) { "maxRestartsPerDownload must be positive" }
+        require(maxRetriesPerDownload > 0) { "maxRetriesPerDownload must be positive" }
+        require(retryWindowMs > 0) { "retryWindowMs must be positive" }
+    }
+    private class Watch(
+        var bytes: Long,
+        var lastProgressAtMs: Long,
+        var downloadingSinceMs: Long?,
+        var startedAtMs: Long?,
+        var restarts: Int = 0,
+        var retries: Int = 0,
+    )
+
+    private val watches = mutableMapOf<String, Watch>()
+
+    /**
+     * Feeds one observation in and returns what to do about it. [nowMs] is the watchdog's own clock, so
+     * the decisions do not depend on timestamps inside Media3.
+     */
+    fun onObservation(observation: DownloadRecoveryObservation, nowMs: Long): DownloadRecoveryAction {
+        val watch = watches.getOrPut(observation.id) {
+            Watch(observation.bytesDownloaded, nowMs, downloadingSinceMs = null, startedAtMs = null)
+        }
+        val rowStartedAtMs = observation.rowStartedAtMs
+        if (rowStartedAtMs != null && watch.startedAtMs != null && rowStartedAtMs != watch.startedAtMs) {
+            // The row was re-created, so this is a new attempt: give the restart budget back and re-baseline
+            // the clocks. The retry budget deliberately survives every rebuild - the watchdog's own retry
+            // rebuilds the row too, and telling the two apart by timing cannot work: a frozen process notices
+            // the rebuild minutes later and would read its own retry as a new attempt. One automatic retry per
+            // download per session is the predictable rule; a user who re-downloads sees a visible failure and
+            // can retry by hand.
+            watch.restarts = 0
+            watch.downloadingSinceMs = null
+            watch.lastProgressAtMs = nowMs
+            watch.bytes = observation.bytesDownloaded
+        }
+        if (rowStartedAtMs != null) {
+            watch.startedAtMs = rowStartedAtMs
+        }
+        if (!observation.online) {
+            // Offline time is not the download's fault. Re-baseline every clock so the outage is never
+            // charged to the stall or crawl budget, and decide nothing while there is no network - Media3
+            // parks the download in QUEUED and resumes it when connectivity returns.
+            watch.downloadingSinceMs = null
+            watch.lastProgressAtMs = nowMs
+            watch.bytes = observation.bytesDownloaded
+            return DownloadRecoveryAction.NONE
+        }
+        return when (observation.phase) {
+            DownloadRecoveryPhase.DOWNLOADING -> onDownloading(watch, observation, nowMs)
+            DownloadRecoveryPhase.FAILED -> onFailed(watch, observation, nowMs)
+            // Not downloading, so it cannot be stalled; the clock starts again when it resumes. A finished or
+            // removed download never reaches here from the adapter - its row leaves the read set and [endPass]
+            // forgets it - but a caller feeding those phases gets the same "do nothing" answer.
+            else -> {
+                watch.downloadingSinceMs = null
+                DownloadRecoveryAction.NONE
+            }
+        }
+    }
+
+    private fun onDownloading(watch: Watch, observation: DownloadRecoveryObservation, nowMs: Long): DownloadRecoveryAction {
+        val startedAt = watch.downloadingSinceMs
+        if (startedAt == null) {
+            // First sight of this attempt: take a baseline rather than judging it against a stale one.
+            watch.downloadingSinceMs = nowMs
+            watch.lastProgressAtMs = nowMs
+            watch.bytes = observation.bytesDownloaded
+            return DownloadRecoveryAction.NONE
+        }
+        if (observation.bytesDownloaded != watch.bytes) {
+            // Any change counts as progress, including bytes going backwards after a restart.
+            watch.bytes = observation.bytesDownloaded
+            watch.lastProgressAtMs = nowMs
+        }
+        val stalled = nowMs - watch.lastProgressAtMs >= stallTimeoutMs
+        val tooSlow = nowMs - startedAt >= slowTransferTimeoutMs
+        if (!stalled && !tooSlow) return DownloadRecoveryAction.NONE
+        if (watch.restarts >= maxRestartsPerDownload) return DownloadRecoveryAction.NONE
+        watch.restarts++
+        // The restart begins a new attempt, so re-baseline both clocks for it.
+        watch.downloadingSinceMs = null
+        watch.lastProgressAtMs = nowMs
+        return DownloadRecoveryAction.RESTART
+    }
+
+    private fun onFailed(
+        watch: Watch,
+        observation: DownloadRecoveryObservation,
+        nowMs: Long,
+    ): DownloadRecoveryAction {
+        // A failure that predates this watch belongs to an earlier session: the retry budget died with that
+        // process, so retrying here would re-queue (and re-notify about) the same dead download on every launch.
+        if (!observation.failureIsFromThisSession) return DownloadRecoveryAction.NONE
+        if (watch.retries >= maxRetriesPerDownload) return DownloadRecoveryAction.NONE
+        // A failed row outlives the process, so without this window every launch would re-queue a download
+        // that is permanently dead and notify the user about it again.
+        val failureAgeMs = observation.failureAgeMs
+        if (failureAgeMs != null && failureAgeMs > retryWindowMs) return DownloadRecoveryAction.NONE
+        watch.retries++
+        watch.downloadingSinceMs = null
+        return DownloadRecoveryAction.RETRY
+    }
+
+    /**
+     * Returns the budget a decided action would have spent, for a caller that then found the download had
+     * moved on and did nothing about it. Without this the download would lose a restart, or its single retry,
+     * for an action that never happened.
+     */
+    fun onActionSkipped(id: String) {
+        val watch = watches[id] ?: return
+        if (watch.restarts > 0) watch.restarts--
+        if (watch.retries > 0) watch.retries--
+        watch.downloadingSinceMs = null
+    }
+
+    /**
+     * Drops the bookkeeping of every download that was missing from the pass that just ended.
+     *
+     * A download removed between two passes is never observed as REMOVING (Media3 deletes the row as soon as
+     * the removal finishes), so without this the entry - and its spent restart and retry budgets - would
+     * survive for the life of the process and a later re-download of the same song would inherit them. The
+     * caller must only prune after a successful read of the index, where every surviving row was observed.
+     */
+    fun endPass(observedIds: Set<String>) {
+        watches.keys.retainAll(observedIds)
+    }
+}
