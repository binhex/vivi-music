+++ b/app/src/main/kotlin/com/music/vivi/playback/DownloadWatchdog.kt
@@ -0,0 +1,201 @@
+/**
+ * vivimusic Project (C) 2026
+ * Licensed under GPL-3.0 | See git history for contributors
+ */
+
+package com.music.vivi.playback
+
+import android.content.Context
+import android.net.ConnectivityManager
+import android.net.NetworkCapabilities
+import android.os.SystemClock
+import androidx.core.content.getSystemService
+import androidx.media3.exoplayer.offline.Download
+import androidx.media3.exoplayer.offline.DownloadManager
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import timber.log.Timber
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * The Android half of the local patch's download recovery: every [DOWNLOAD_WATCH_INTERVAL_MS] it reads
+ * Media3's download index, asks [DownloadRecoveryPolicy] what to do about each download, and applies the
+ * answer. It exists because Media3 has no wall-clock deadline of its own: a download whose transfer crawls
+ * or whose stream URL keeps expiring cycles inside `STATE_DOWNLOADING` for minutes, with no progress
+ * callback and no failure, so the UI shows a spinner that never ends.
+ *
+ * Deliberately thin: every decision lives in [DownloadRecoveryPolicy], which is pure Kotlin and unit
+ * tested, and the Media3 state numbers are mapped by [downloadPhaseOf]. This class only reads, logs and
+ * calls - and each pass runs on the thread that owns the manager (see [start]).
+ *
+ * Readings the loop costs and why that is acceptable: one indexed read per tick, restricted to the queued,
+ * downloading and failed rows - typically a handful, even in a library with thousands of finished downloads.
+ * A download that has just failed leaves the manager's current downloads, so the index is the only place its
+ * `FAILED` row can still be seen; skipping the read when nothing looks active would lose exactly the failure
+ * this is meant to retry.
+ *
+ * Nothing here touches upstream code: the patch adds one constructor parameter and one `start` call, and
+ * closes the index cursor that `DownloadUtil`'s own initialisation used to leak.
+ */
+@Singleton
+class DownloadWatchdog
+@Inject
+constructor(
+    @ApplicationContext private val context: Context,
+) {
+    private val policy = DownloadRecoveryPolicy()
+
+    /**
+     * Starts watching. The loop lives in [scope] so the owner can cancel it - nulling this class out on
+     * its own would leave the loop running with nothing to watch.
+     *
+     * Each pass is dispatched onto `Dispatchers.Main.immediate` because Media3 documents that a
+     * `DownloadManager` instance must only be accessed from the thread that created it, which for this app is
+     * the main thread; every other call site goes through `DownloadService` for the same reason. The pass
+     * itself does one indexed read plus the recoveries it decides on - the same kind of work, on the same
+     * thread, as `DownloadUtil`'s own initialisation, which reads the whole index once for the UI.
+     */
+    fun start(scope: CoroutineScope, downloadManager: DownloadManager) {
+        scope.launch {
+            Timber.tag(TAG).d("Download watchdog started, checking every %d ms", DOWNLOAD_WATCH_INTERVAL_MS)
+            // Failures older than this belong to an earlier process, whose retry budget died with it.
+            val watchingSinceWallMs = System.currentTimeMillis()
+            while (isActive) {
+                delay(DOWNLOAD_WATCH_INTERVAL_MS)
+                try {
+                    withContext(Dispatchers.Main.immediate) { watchOnce(downloadManager, watchingSinceWallMs) }
+                } catch (e: CancellationException) {
+                    throw e
+                } catch (e: Exception) {
+                    // A recovery pass must never take the app down; the next tick tries again.
+                    Timber.tag(TAG).w(e, "Download watch tick failed")
+                }
+            }
+        }
+    }
+
+    private fun watchOnce(downloadManager: DownloadManager, watchingSinceWallMs: Long) {
+        val online = isOnline()
+        // A monotonic clock: an NTP or user clock change must not look like a stall, nor hide one.
+        val now = SystemClock.elapsedRealtime()
+        val observed = mutableSetOf<String>()
+        // Queued rows are read as well as downloading and failed ones, and that is not incidental: a re-added
+        // request parks in QUEUED while Media3 cancels the old task and starts a new one, so a pass that did
+        // not see it would prune the download and hand its spent restart and retry budgets back. Completed and
+        // stopped rows are deliberately left out - a library holds a row per downloaded song and there is
+        // nothing to decide about them - which also keeps the read small.
+        //
+        // The cursor is drained before anything is decided, because acting inside the loop writes to the very
+        // index being scanned (a merge rewrites the row) and a live cursor guarantees nothing about a result
+        // set that changes under it.
+        val rows = mutableListOf<Download>()
+        downloadManager.downloadIndex
+            .getDownloads(Download.STATE_QUEUED, Download.STATE_DOWNLOADING, Download.STATE_FAILED)
+            .use { cursor ->
+                while (cursor.moveToNext()) {
+                    rows += cursor.download
+                }
+            }
+
+        for (download in rows) {
+            observed += download.request.id
+            val prediction = DownloadRecoveryObservation(
+                    id = download.request.id,
+                    phase = downloadPhaseOf(download.state),
+                    bytesDownloaded = download.bytesDownloaded,
+                    online = online,
+                    // Media3 writes row timestamps from the wall clock while the pass clock is monotonic, so
+                    // the age is measured here, where both clocks are available.
+                    failureAgeMs = if (download.state == Download.STATE_FAILED) {
+                        (System.currentTimeMillis() - download.updateTimeMs).coerceAtLeast(0L)
+                    } else {
+                        null
+                    },
+                    // A failure older than this watch belongs to an earlier process; its retry budget did too.
+                    failureIsFromThisSession = download.updateTimeMs >= watchingSinceWallMs,
+                    rowStartedAtMs = download.startTimeMs,
+            )
+            val action = policy.onObservation(prediction, now)
+            when (action) {
+                DownloadRecoveryAction.RESTART ->
+                    requeue(downloadManager, download, prediction.phase, "Restarting a download with no progress")
+                DownloadRecoveryAction.RETRY ->
+                    requeue(downloadManager, download, prediction.phase, "Retrying a failed download")
+                DownloadRecoveryAction.NONE -> Unit
+            }
+        }
+
+        // Only after a complete read: every row the policy can act on, including one parked in the queue, was
+        // just observed, so anything else has really gone and must not keep a spent budget alive.
+        policy.endPass(observed)
+    }
+
+    /**
+     * Restarts a stalled download or retries a failed one by re-adding its request.
+     *
+     * Media3 merges the request into the existing row and puts it back to `QUEUED`, which cancels the running
+     * task - interrupting a transfer blocked inside the data source, including one blocked in the stream URL
+     * resolution, so this also bounds that call - and starts a fresh task. The download cache is untouched,
+     * so the bytes already fetched are reused and only the missing tail is fetched, and the row keeps its
+     * identity, so the user sees the same download carry on.
+     *
+     * The manager is called directly rather than through `DownloadService.sendAddDownload`, because that
+     * helper starts the service with `startService`, which Android forbids from the background - exactly where
+     * a stalled download is usually found. The trade-off is that a recovery started while the app is in the
+     * background runs without the download service holding the process, so the OS may park it until the app
+     * is next launched; the request keeps its identity and its cached bytes, so it simply carries on then.
+     *
+     * The same call serves both actions because it is the only restart path that never passes through
+     * `STATE_STOPPED`: the app's own listener reads that state as "no longer downloaded" and would clear
+     * `isDownloaded` and `dateDownload` for a re-download that still has a playable cached copy. `removeDownload`
+     * would be worse still - it deletes the cached bytes.
+     */
+    private fun requeue(
+        downloadManager: DownloadManager,
+        download: Download,
+        expectedPhase: DownloadRecoveryPhase,
+        reason: String,
+    ) {
+        val id = download.request.id
+        // Decide from a fresh row, not the snapshot this pass read: re-adding is asynchronous, so a download
+        // the user removed (or that moved on) while the pass was running must not be brought back to life.
+        val current = runCatching { downloadManager.downloadIndex.getDownload(id) }.getOrNull()
+        if (current == null || downloadPhaseOf(current.state) != expectedPhase) {
+            Timber.tag(TAG).d("Skipping %s: its state changed before the action could be applied", id)
+            // Give the budget back: the policy already spent it when it decided, and nothing was done.
+            policy.onActionSkipped(id)
+            return
+        }
+        Timber.tag(TAG).w("%s: %s (%.1f%%)", reason, id, current.percentDownloaded)
+        downloadManager.addDownload(current.request)
+    }
+
+    /**
+     * True when downloads can be expected to reach the internet.
+     *
+     * Requires `VALIDATED` as well as `INTERNET`, deliberately stricter than plain connectivity: a captive
+     * portal reports `INTERNET` without ever validating, and treating that as online would spend a download's
+     * whole recovery budget against a network that cannot serve media. Media3 applies the same check, but only
+     * when a network-type requirement has been set, which this app never does - so the trade-off is ours, and
+     * it cuts the other way on a network that carries media but never validates, where recovery waits instead
+     * of churning.
+     */
+    private fun isOnline(): Boolean {
+        val connectivity = context.getSystemService<ConnectivityManager>() ?: return false
+        val network = connectivity.activeNetwork ?: return false
+        val capabilities = connectivity.getNetworkCapabilities(network) ?: return false
+        return capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET) &&
+            capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED)
+    }
+
+    private companion object {
+        const val TAG = "DownloadWatchdog"
+    }
+}
