+    @Test
+    fun `tracking is per download so one stalled song does not disturb another`() {
+        val policy = policy(stallTimeoutMs = 1_000L)
+
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(id = "a", bytes = 0L), 0L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(id = "b", bytes = 0L), 0L))
+        assertEquals(DownloadRecoveryAction.RESTART, policy.onObservation(downloading(id = "a", bytes = 0L), 1_000L))
+        assertEquals(DownloadRecoveryAction.NONE, policy.onObservation(downloading(id = "b", bytes = 100L), 1_000L))
+    }
