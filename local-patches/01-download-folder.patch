+ * Licensed under GPL-3.0 | See git history for contributors
+ */
+
+package com.music.vivi.playback
+
+import android.content.ContentUris
+import android.content.ContentResolver
+import android.content.ContentValues
+import android.content.Context
+import android.net.Uri
+import android.os.Build
+import android.os.Environment
+import android.provider.MediaStore
+import androidx.annotation.RequiresApi
+import androidx.core.net.toUri
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.datasource.DataSpec
+import androidx.media3.datasource.cache.CacheDataSource
+import androidx.media3.datasource.cache.SimpleCache
+import com.music.vivi.db.MusicDatabase
+import com.music.vivi.db.entities.Song
+import com.music.vivi.di.DownloadCache
+import com.music.vivi.utils.dataStore
+import com.music.vivi.utils.get
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import timber.log.Timber
+import java.io.File
+import java.io.IOException
+import java.io.OutputStream
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Copies a finished download out of the private Media3 cache (`filesDir/download`, which the user can
+ * never see) into a real audio file, so downloaded tracks show up in a file manager or any other
+ * music player.
+ *
+ * Destination:
+ *  - the SAF folder picked in Storage settings, when one is set and still writable, otherwise
+ *  - `Music/Vivi` in public storage via MediaStore on API 29+, or the app-specific external music
+ *    directory on API 26-28 (visible to file managers there, and it needs no runtime permission).
+ *
+ * The cached download is never modified - it stays the source for offline playback - so an export
+ * failure can never break playback or lose the download.
+ */
+@OptIn(UnstableApi::class)
+@Singleton
+class DownloadFolderExporter
+@Inject
+constructor(
+    @ApplicationContext private val context: Context,
+    private val database: MusicDatabase,
+    @DownloadCache private val downloadCache: SimpleCache,
+) {
+    /** Exports are small local copies; serialising them keeps a re-download from racing itself. */
+    private val exportMutex = Mutex()
+
+    /**
+     * Exports [songId] when the feature is enabled. Never throws: failures are logged and the cached
+     * download stays intact.
+     */
+    suspend fun export(songId: String) {
+        withContext(Dispatchers.IO) {
+            if (context.dataStore[DownloadFolderExportEnabledKey] == false) return@withContext
+            exportMutex.withLock { exportLocked(songId) }
+        }
+    }
+
+    private suspend fun exportLocked(songId: String) {
+        val song = try {
+            database.song(songId).first()
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Timber.tag(TAG).w(e, "Could not read song %s", songId)
+            null
+        }
+        if (song == null) {
+            Timber.tag(TAG).w("No database row for %s, skipping export", songId)
+            return
+        }
+
+        val mimeType = song.format?.mimeType
+            .orEmpty()
+            .substringBefore(';')
+            .trim()
+            .ifEmpty { DEFAULT_MIME_TYPE }
+        val fileName = buildFileName(song, mimeType)
+
+        try {
+            write(songId, fileName, mimeType)
+            Timber.tag(TAG).i("Exported %s as %s", songId, fileName)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Timber.tag(TAG).e(e, "Export failed for %s, cached download is intact", songId)
+        }
+    }
+
+    private fun write(songId: String, fileName: String, mimeType: String) {
+        val folderUri = context.dataStore[DownloadFolderUriKey].orEmpty()
+        if (folderUri.isNotBlank()) {
+            try {
+                writeToDocumentTree(folderUri.toUri(), songId, fileName, mimeType)
+                return
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                // A revoked grant or a folder that turned read-only must not lose the export: fall
+                // through to Music/Vivi instead of writing nothing at all.
+                Timber.tag(TAG).w(e, "Chosen folder failed, using Music/%s", SUBFOLDER)
+            }
+        }
+        writeToPublicMusic(songId, fileName, mimeType)
+    }
+
+    private fun writeToDocumentTree(
+        treeUri: Uri,
+        songId: String,
+        fileName: String,
+        mimeType: String,
+    ) {
+        val uri = SafFolders.createOrReplaceFile(context, treeUri, mimeType, fileName)
+            ?: throw IOException("Could not create $fileName in $treeUri")
+        try {
+            val output = context.contentResolver.openOutputStream(uri, OPEN_MODE_TRUNCATE)
+                ?: throw IOException("Could not open output stream for $uri")
+            output.use { copyFromCache(songId, it) }
+        } catch (e: Exception) {
+            SafFolders.delete(context, uri)
+            throw e
+        }
+    }
+
+    private fun writeToPublicMusic(songId: String, fileName: String, mimeType: String) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) {
+            writeToAppSpecificMusicDir(songId, fileName)
+        } else {
+            writeViaMediaStore(songId, fileName, mimeType)
+        }
+    }
+
+    @RequiresApi(Build.VERSION_CODES.Q)
+    private fun writeViaMediaStore(songId: String, fileName: String, mimeType: String) {
+        val resolver = context.contentResolver
+        val collection = MediaStore.Audio.Media.EXTERNAL_CONTENT_URI
+        val relativePath = "${Environment.DIRECTORY_MUSIC}/$SUBFOLDER"
+
+        deleteOwnExports(resolver, collection, fileName, relativePath)
+
+        val uri = resolver.insert(
+            collection,
+            ContentValues().apply {
+                put(MediaStore.Audio.Media.DISPLAY_NAME, fileName)
+                put(MediaStore.Audio.Media.MIME_TYPE, mimeType)
+                put(MediaStore.Audio.Media.RELATIVE_PATH, relativePath)
+                put(MediaStore.Audio.Media.IS_PENDING, 1)
+            },
+        ) ?: throw IOException("MediaStore refused to create $fileName")
+
+        try {
+            val output = resolver.openOutputStream(uri)
+                ?: throw IOException("Could not open output stream for $uri")
+            output.use { copyFromCache(songId, it) }
+        } catch (e: Exception) {
+            runCatching { resolver.delete(uri, null, null) }
+            throw e
+        }
+
+        // Publishing is best effort: failing to clear IS_PENDING must not delete a complete file.
+        runCatching {
+            resolver.update(
+                uri,
+                ContentValues().apply { put(MediaStore.Audio.Media.IS_PENDING, 0) },
+                null,
+                null,
+            )
+        }.onFailure { Timber.tag(TAG).w(it, "Could not publish %s", fileName) }
+    }
+
+    /**
+     * Removes this app's previous export of the same song so the new file can take the name.
+     *
+     * Only rows this package owns are deleted - a same-named file from another app is not ours, and
+     * MediaStore renames ours instead of overwriting it - and a refused delete is logged rather than
+     * failing the export.
+     */
+    @RequiresApi(Build.VERSION_CODES.Q)
+    private fun deleteOwnExports(
+        resolver: ContentResolver,
+        collection: Uri,
+        fileName: String,
+        relativePath: String,
+    ) {
+        val ownedIds = mutableListOf<Long>()
+        runCatching {
+            resolver.query(
+                collection,
+                arrayOf(MediaStore.Audio.Media._ID, MediaStore.MediaColumns.OWNER_PACKAGE_NAME),
+                "${MediaStore.Audio.Media.DISPLAY_NAME} = ? AND " +
+                    "${MediaStore.Audio.Media.RELATIVE_PATH} = ?",
+                arrayOf(fileName, "$relativePath/"),
+                null,
+            )?.use { cursor ->
+                while (cursor.moveToNext()) {
+                    if (cursor.getString(1) == context.packageName) ownedIds += cursor.getLong(0)
+                }
+            }
+        }.onFailure { Timber.tag(TAG).w(it, "Could not look up a previous export of %s", fileName) }
+
+        ownedIds.forEach { id ->
+            runCatching { resolver.delete(ContentUris.withAppendedId(collection, id), null, null) }
+                .onFailure { Timber.tag(TAG).w(it, "Could not replace the previous export of %s", fileName) }
+        }
+    }
+
+    /**
+     * API 26-28: no MediaStore write without a runtime storage permission, but `Android/data` is not
+     * hidden yet on these versions, so the app-specific external directory is still user-visible.
+     */
+    private fun writeToAppSpecificMusicDir(songId: String, fileName: String) {
+        val base = context.getExternalFilesDir(Environment.DIRECTORY_MUSIC)
+        if (base == null) {
+            Timber.tag(TAG).w("External music directory unavailable, using internal storage")
+        }
+        val directory = File(base ?: context.filesDir, SUBFOLDER)
+        if (!directory.exists() && !directory.mkdirs()) {
+            Timber.tag(TAG).w("Could not create %s", directory)
+        }
+        val file = File(directory, fileName)
+        try {
+            file.outputStream().use { copyFromCache(songId, it) }
+        } catch (e: Exception) {
+            runCatching { file.delete() }
+            throw e
+        }
+    }
+
+    /**
+     * Reads the finished download straight out of the download cache.
+     *
+     * The request is bounded to the bytes the cache actually holds: a null upstream means "the cache
+     * contains everything requested", so reading past that point would be an error rather than the
+     * end of the stream.
+     */
+    private fun copyFromCache(songId: String, output: OutputStream) {
+        val expected = downloadCache.getCachedBytes(songId, 0, Long.MAX_VALUE)
+        if (expected <= 0L) throw IOException("Nothing cached for $songId")
+
+        val dataSource = CacheDataSource(downloadCache, null)
+        try {
+            dataSource.open(
+                DataSpec.Builder()
+                    .setUri(songId.toUri())
+                    .setKey(songId)
+                    .setLength(expected)
+                    .build(),
+            )
+            var total = 0L
+            val buffer = ByteArray(BUFFER_SIZE)
+            while (total < expected) {
+                val request = minOf(buffer.size.toLong(), expected - total).toInt()
+                val read = dataSource.read(buffer, 0, request)
+                if (read <= 0) break
+                output.write(buffer, 0, read)
+                total += read
+            }
+            if (total != expected) throw IOException("Copied $total of $expected cached bytes for $songId")
+        } finally {
+            runCatching { dataSource.close() }
+        }
+    }
+
+    private fun buildFileName(song: Song, mimeType: String): String {
+        val artist = song.artists.joinToString(", ") { it.name }.ifBlank { UNKNOWN_ARTIST }
+        val extension = extensionFor(mimeType)
+        val base = truncateToBytes(
+            sanitizeFileName("$artist - ${song.song.title}"),
+            MAX_NAME_BYTES - extension.length,
+        ).trimEnd('.', ' ')
+        return "${base.ifBlank { song.song.id }}$extension"
+    }
+
+    private fun extensionFor(mimeType: String): String = when {
+        mimeType.contains("webm") -> ".webm"
+        mimeType.contains("mp4") || mimeType.contains("aac") -> ".m4a"
+        mimeType.contains("mpeg") -> ".mp3"
+        mimeType.contains("opus") -> ".opus"
+        mimeType.contains("ogg") -> ".ogg"
+        mimeType.contains("flac") -> ".flac"
+        else -> ".m4a"
+    }
+
+    private fun sanitizeFileName(name: String): String = name
+        .replace(INVALID_FILE_CHARS, "_")
+        .replace(WHITESPACE, " ")
+        .trim()
+
+    /**
+     * Filesystems limit a name to 255 bytes, not characters: a 120-character CJK or Cyrillic title is
+     * three times that and would otherwise fail the export with nothing but a log line.
+     */
+    private fun truncateToBytes(name: String, maxBytes: Int): String {
+        if (name.toByteArray(Charsets.UTF_8).size <= maxBytes) return name
+        var end = name.length
+        while (end > 0 && name.substring(0, end).toByteArray(Charsets.UTF_8).size > maxBytes) end--
+        val truncated = name.substring(0, end)
+        return if (truncated.isNotEmpty() && truncated.last().isHighSurrogate()) truncated.dropLast(1) else truncated
+    }
+
+    private companion object {
+        const val TAG = "DownloadFolderExporter"
+        const val SUBFOLDER = "Vivi"
+        const val DEFAULT_MIME_TYPE = "audio/mp4"
+        const val UNKNOWN_ARTIST = "Unknown Artist"
+        const val OPEN_MODE_TRUNCATE = "wt"
+        const val BUFFER_SIZE = 64 * 1024
+        const val MAX_NAME_BYTES = 200
+        val INVALID_FILE_CHARS = Regex("[\\\\/:*?\"<>|]")
+        val WHITESPACE = Regex("\\s+")
+    }
+}
