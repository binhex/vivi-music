+package com.music.vivi.playback
+
+import androidx.datastore.preferences.core.booleanPreferencesKey
+import androidx.datastore.preferences.core.stringPreferencesKey
+
+/**
+ * Preferences owned by the "save downloads to a folder" patch.
+ *
+ * They live here instead of in `constants/PreferenceKeys.kt` on purpose: that file is touched by
+ * almost every upstream release, and an added line there is the most likely thing to make this patch
+ * stop applying. Same reasoning as the dedicated strings file.
+ */
+val DownloadFolderExportEnabledKey = booleanPreferencesKey("downloadFolderExportEnabled")
+
+/** Storage Access Framework tree URI of the folder the user picked, or empty for `Music/Vivi`. */
+val DownloadFolderUriKey = stringPreferencesKey("downloadFolderUri")
+
+/** Folder structure template such as `%artist%/%album%`; empty means flat. */
+val DownloadFolderTemplateKey = stringPreferencesKey("downloadFolderTemplate")
+
+/** File-name template such as `%artist% - %album% - %tracknumber% - %title%`; blank means the default. */
+val DownloadFormatFileKey = stringPreferencesKey("downloadFormatFile")
+
+/** Whether trailing video tags are stripped from metadata before it reaches a folder or file name. */
+val DownloadFormatCleanKey = booleanPreferencesKey("downloadFormatClean")
